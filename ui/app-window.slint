                font-size: 10px;
                font-weight: 800;
            }

            Text {
                x: 12px;
                y: 34px;
                width: 258px;
                text: "Παρατήρησε πώς η χωρητική και η επαγωγική αντίδραση επηρεάζουν τη σύνθετη αντίσταση, το ρεύμα και τη γωνία φάσης.";
                color: #94a3b8;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
    }

    // Main visual area: circuit, phase diagram, triangles
    Rectangle {
        x: 360px;
        y: 94px;
        width: parent.width - 380px;
        height: 340px;
        background: transparent;
        // Circuit schematic card
        Rectangle {
            x: 0;
            y: 0;
            width: 335px;
            height: 340px;
            background: #111c2e;
            border-color: #26364d;
            border-width: 1px;
            border-radius: 16px;
