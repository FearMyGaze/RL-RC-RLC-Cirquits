            pressed(m) => { root.mode_selected(m); }
        }

        ModeButton {
            x: 114px;
            y: 82px;
            label: "RL";
            mode: 1;
            active-mode: root.circuit_mode;
            pressed(m) => { root.mode_selected(m); }
        }

        ModeButton {
            x: 210px;
            y: 82px;
            label: "RLC";
            mode: 2;
            active-mode: root.circuit_mode;
            pressed(m) => { root.mode_selected(m); }
        }

        Text {
            x: 18px;
            y: 130px;
            width: 284px;
            text: "Μετακίνησε τους ρυθμιστές για να αλλάξεις τις ηλεκτρικές παραμέτρους.";
            color: #64748b;
            font-size: 10px;
            wrap: word-wrap;
        }

        VerticalLayout {
            x: 18px;
            y: 174px;
            width: 284px;
            height: root.circuit_mode == 1 ? 400px : 404px;
            spacing: root.circuit_mode == 1 ? 32px : 6px;
