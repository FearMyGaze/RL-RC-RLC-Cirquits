            pressed => { root.quick_speed(0.50); }
        }

        Rectangle {
            x: 18px;
            y: 754px;
            width: 284px;
            height: 105px;
            background: #0b1525;
            border-color: #26364d;
            border-width: 1px;
            border-radius: 10px;
