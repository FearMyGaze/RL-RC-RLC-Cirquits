                width: 265px;
                height: 2px;
                background: #64748b;
            }

            Rectangle {
                x: 300px;
                y: 160px;
                width: 2px;
                height: 102px;
                background: #64748b;
            }

            Rectangle {
                x: 149px;
                y: 242px;
                width: 37px;
                height: 37px;
                border-radius: 19px;
                border-width: 2px;
                border-color: #38bdf8;
                background: #10233a;
                Text {
                    text: "~";
                    color: #38bdf8;
