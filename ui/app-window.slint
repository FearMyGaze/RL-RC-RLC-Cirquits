import { Slider } from "std-widgets.slint";

export struct WaveSegment { x: float, y: float, length: float, rotation: float }

component ModeButton inherits Rectangle {
    in property <string> label;
    in property <int> mode;
    in property <int> active-mode;
    callback pressed(int);
    width: 92px;
    height: 38px;
    border-radius: 8px;
    background: root.active-mode == root.mode ? #4f46e5 : #1e293b;
    border-width: 1px;
    border-color: root.active-mode == root.mode ? #818cf8 : #334155;
    Text {
        text: root.label;
        color: root.active-mode == root.mode ? #ffffff : #cbd5e1;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.pressed(root.mode); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback pressed();
    height: 38px;
    border-radius: 8px;
    background: root.primary ? #4f46e5 : #334155;
    border-width: 1px;
    border-color: root.primary ? #6366f1 : #475569;
    Text {
        text: root.label;
        color: #f8fafc;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.pressed(); }
    }
}

component CalcCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <brush> accent: #e2e8f0;
    in property <length> value-size: 14px;
    height: 60px;
    horizontal-stretch: 1;
    background: #17263a;
    border-radius: 9px;
    border-color: #2b4059;
    border-width: 1px;
    Text {
        x: 10px;
        y: 9px;
        text: root.title;
        color: #94a3b8;
        font-size: 10px;
    }

    Text {
        x: 10px;
        y: 34px;
        text: root.value;
        color: root.accent;
        font-size: root.value-size;
        font-weight: 800;
    }
}

component ConclusionCard inherits Rectangle {
    in property <string> index-text;
    in property <string> title;
    in property <string> text;
    in property <string> formula;
    in property <brush> accent: #38bdf8;
    height: 74px;
    horizontal-stretch: 1;
    background: #17263a;
    border-radius: 9px;
    border-color: #2b4059;
    border-width: 1px;

    Text {
        x: 10px;
        y: 9px;
        width: parent.width - 20px;
        text: root.index-text + ". " + root.title;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 700;
    }

    Text {
        x: 10px;
        y: 26px;
        width: parent.width - 20px;
        text: root.text;
        color: #cbd5e1;
        font-size: 9px;
        wrap: word-wrap;
    }

    Text {
        x: 10px;
        y: 54px;
        width: parent.width - 20px;
        text: root.formula;
        color: root.accent;
        font-size: 10px;
        font-weight: 700;
    }
}

component CircuitPart inherits Rectangle {
    in property <string> label;
    in property <string> value-text;
    in property <brush> accent: #34d399;
    height: 50px;
    background: transparent;
    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.value-text;
        color: root.accent;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    Rectangle {
        x: 0px;
        y: 24px;
        width: parent.width;
        height: 26px;
        background: #1b2a3e;
        border-color: root.accent;
        border-width: 2px;
        border-radius: 4px;
        Text {
            text: root.label;
            color: root.accent;
            font-size: 13px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ParameterControl inherits Rectangle {
    in property <string> label;
    in property <string> value-text;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <brush> accent: #38bdf8;
    callback changed(float);
    height: 76px;
    background: transparent;
    Text {
        x: 2px;
        y: 2px;
        text: root.label;
        color: #cbd5e1;
        font-size: 13px;
        font-weight: 600;
    }

    Text {
        x: parent.width - 105px;
        y: 2px;
        width: 100px;
        text: root.value-text;
        color: root.accent;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: right;
    }

    Slider {
        x: 0px;
        y: 30px;
        width: parent.width;
        height: 30px;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
}

component TriangleCard inherits Rectangle {
    in property <string> title;
    in property <string> base-text;
    in property <string> side-text;
    in property <string> hyp-text;
    in property <float> base-len: 90;
    in property <float> height-len: 40;
    in property <float> sign: 1;
    in property <float> diag-angle: -20;
    width: 184px;
    height: 226px;
    background: #111c2e;
    border-color: #26364d;
    border-width: 1px;
    border-radius: 10px;
    Text {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        text: root.title;
        color: #e2e8f0;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
    }
    // Horizontal (resistive) component.
    Rectangle {
        x: 18px;
        y: 163px;
        width: root.base-len * 1px;
        height: 3px;
        background: #34d399;
    }
    // Reactive component. Positive = inductive/up; negative = capacitive/down.
    Rectangle {
        x: 18px + root.base-len * 1px - 1.5px;
        y: root.sign >= 0 ? 163px - root.height-len * 1px : 163px;
        width: 3px;
        height: root.height-len * 1px;
        background: #f59e0b;
    }
    // Resultant / hypotenuse.
    Rectangle {
        x: 18px;
        y: 163px;
        width: Math.sqrt(root.base-len * root.base-len + root.height-len * root.height-len) * 1px;
        height: 3px;
        background: #38bdf8;
        transform-origin: { x: 0px, y: 1.5px };
        transform-rotation: root.diag-angle * 1deg;
    }

    Text {
        x: 10px;
        y: 174px;
        width: parent.width - 20px;
        text: root.base-text;
        color: #34d399;
        font-size: 10px;
        horizontal-alignment: center;
    }

    Text {
        x: 10px;
        y: 38px;
        width: parent.width - 20px;
        text: root.side-text;
        color: #fbbf24;
        font-size: 10px;
        horizontal-alignment: center;
    }

    Text {
        x: 10px;
        y: 194px;
        width: parent.width - 20px;
        text: root.hyp-text;
        color: #7dd3fc;
        font-size: 10px;
        horizontal-alignment: center;
    }

    Text {
        x: 10px;
        y: 58px;
        width: parent.width - 20px;
        text: root.sign < 0 ? "Χωρητική φορά (−)" : root.sign > 0 ? "Επαγωγική φορά (+)" : "Σε συντονισμό";
        color: #64748b;
        font-size: 9px;
        horizontal-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "Εργαστήριο Κυκλωμάτων RC, RL & RLC";
    width: 1510px;
    height: 1000px;
    background: #0b1220;

    in-out property <int> circuit_mode: 1;
    in-out property <float> l_value: 100;
    in-out property <float> c_value: 100;
    in-out property <float> r_value: 31.4;
    in-out property <float> frequency_value: 50;
    in-out property <float> voltage_value: 230;
    in-out property <float> speed_value: 0.2;
    in-out property <string> l_text: "100 mH";
    in-out property <string> c_text: "100 μF";
    in-out property <string> r_text: "31.4 Ω";
    in-out property <string> frequency_text: "50 Hz";
    in-out property <string> voltage_text: "230 V";
    in-out property <string> speed_text: "0.20x";
    in-out property <string> play_text: "Παύση";
    in-out property <string> mode_title: "Κύκλωμα σειράς RL";
    in-out property <string> mode_hint: "Το ρεύμα καθυστερεί ως προς την τάση";
    in-out property <string> phase_legend: "ΚΑΘΥΣΤΕΡΗΣΗ · φ = 45°";
    in-out property <string> calc_xl: "XL = 31.42 Ω";
    in-out property <string> calc_xc: "XC = 31.83 Ω";
    in-out property <string> calc_xnet: "XL = 31.42 Ω";
    in-out property <string> calc_z: "Z = 44.43 Ω";
    in-out property <string> calc_i: "Irms = 5.18 A";
    in-out property <string> calc_phi: "φ = 45.0°";
    in-out property <string> calc_phi_state: "ΚΑΘΥΣΤΕΡΗΣΗ";
    in-out property <string> calc_dt: "Δt = 2.50 ms";
    in-out property <string> calc_resonance: "f₀ = 1.59 kHz";
    in-out property <string> calc_vr: "VR = 162 V";
    in-out property <string> calc_vx: "VL = 162 V";
    in-out property <string> calc_v: "V = 230 V";
    in-out property <string> calc_r: "R = 31.4 Ω";
    in-out property <string> calc_x: "XL = 31.42 Ω";
    in-out property <string> calc_z_triangle: "Z = 44.43 Ω";
    in-out property <string> conclusion_title: "ΒΑΣΙΚΑ ΣΥΜΠΕΡΑΣΜΑΤΑ · RL";
    in-out property <string> conclusion_1_title: "Φάση ρεύματος";
    in-out property <string> conclusion_1: "Το ρεύμα καθυστερεί της τάσης κατά φ (επαγωγική συμπεριφορά).";
    in-out property <string> conclusion_1_formula: "φ = +arctan(XL / R)";
    in-out property <string> conclusion_2_title: "Επίδραση f και L";
    in-out property <string> conclusion_2: "Αύξηση της f ή της L αυξάνει το XL, άρα μειώνει το ρεύμα και αυξάνει το |φ|.";
    in-out property <string> conclusion_2_formula: "XL = 2π·f·L";
    in-out property <string> conclusion_3_title: "Τάσεις στοιχείων";
    in-out property <string> conclusion_3: "Η τάση VR είναι σε φάση με το ρεύμα, ενώ η VL προηγείται κατά 90°.";
    in-out property <string> conclusion_3_formula: "VR = I·R   VL = I·XL";
    in-out property <float> triangle_base: 84;
    in-out property <float> triangle_height: 84;
    in-out property <float> triangle_angle: -45;
    in-out property <float> triangle_sign: 1;
    in-out property <string> voltage_triangle_base: "VR 162 V";
    in-out property <string> voltage_triangle_side: "VL 162 V";
    in-out property <string> voltage_triangle_hyp: "V 230 V";
    in-out property <string> impedance_triangle_base: "R 31 Ω";
    in-out property <string> impedance_triangle_side: "XL 31 Ω";
    in-out property <string> impedance_triangle_hyp: "Z 44 Ω";
    in-out property <float> voltage_vector_angle: 0;
    in-out property <float> current_vector_angle: 45;
    in-out property <float> voltage_tip_x: 303;
    in-out property <float> voltage_tip_y: 153;
    in-out property <float> current_tip_x: 281;
    in-out property <float> current_tip_y: 153;
    in-out property <float> angle_bubble_x: 200;
    in-out property <float> angle_bubble_y: 105;
    in-out property <string> angle_badge: "45°";
    in-out property <[WaveSegment]> voltage_wave: [];
    in-out property <[WaveSegment]> current_wave: [];
    in-out property <string> scope_voltage_scale: "Vp = 325.27 V  ·  Vrms = 230.00 V  ·  κλίμακα ±600 V";
    in-out property <string> scope_current_scale: "Ip = 7.32 A  ·  Irms = 5.18 A  ·  κλίμακα ±15.0 A";
    in-out property <string> scope_time_base: "Βάση χρόνου: 5.0 ms/div  ·  παράθυρο 50 ms";
    in-out property <float> animation_time: 0;
    callback mode_selected(int);
    callback l_changed(float);
    callback c_changed(float);
    callback r_changed(float);
    callback frequency_changed(float);
    callback voltage_changed(float);
    callback speed_changed(float);
    callback play_clicked();
    callback reset_clicked();
    callback quick_speed(float);

    // Header
    Rectangle {
        x: 0;
        y: 0;
